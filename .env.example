# ===========================================================================
# CampusFit Configuration
# ===========================================================================

# Secret key for session security
CAMPUSFIT_SECRET=campusfit_secret_key_2026_sih

# ---------------------------------------------------------------------------
# Google Gemini API Key (Optional for AI Coach)
# Get a free key at: https://aistudio.google.com/app/apikey
# If omitted, CampusFit uses its built-in expert conversational fitness engine.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Live SMTP Email Configuration (For Sending Real Emails to Your Account)
# ---------------------------------------------------------------------------
# For Gmail:
# 1. Go to your Google Account > Security > 2-Step Verification
# 2. At the bottom, click "App Passwords"
# 3. Create an app password named "CampusFit" (16 characters)
# 4. Fill in below:
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusFit Notifications <notifications@campusfit.com>
